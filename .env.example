# FreeFamilyDisplay — environment template
#
# Copy to `.env` and fill in. NEVER commit a filled-in copy.
# Every value here is intentionally EMPTY: per CLAUDE.md, no secret is ever
# written to disk in this repository, including in examples and fixtures.
#
# You MUST set: APP_URL, SITE_HOST, TZ, DATABASE_URL, POSTGRES_*, REDIS_URL,
# MASTER_KEY, SESSION_SECRET. Everything else can stay blank forever.
# README.md walks through each one with the command that generates it.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Public origin of the admin UI. On the LAN this is https://<SITE_HOST>:8443
# (Caddy internal CA); with the tunnel it becomes the public hostname.
# The scheme here drives the session cookie's Secure flag — keep it accurate.
APP_URL=

# LAN IP the displays and phones use — Caddy mints its TLS cert for this.
SITE_HOST=

# Your household's wall clock, as an IANA name (Europe/London, Asia/Tokyo,
# America/Chicago). CHANGE THIS. Boards render on the server, so a wrong value
# is silent and cosmetic until evening, when the wall display starts showing
# TOMORROW'S date — dates roll over at UTC midnight, not yours.
TZ=America/Chicago

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16
# ---------------------------------------------------------------------------

# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Used only by the postgres container in infra/compose.yaml.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# Redis — queue and cache
# ---------------------------------------------------------------------------

# redis://HOST:6379
REDIS_URL=

# ---------------------------------------------------------------------------
# Secrets at rest (plan §8.2)
# ---------------------------------------------------------------------------

# 32 random bytes, base64. Wraps per-connection data keys (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# In production this comes from a 0400 file owned by the service user and is
# injected as an env var. It is never written into the compose file.
MASTER_KEY=

# 32 random bytes, base64. Signs the session cookie.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email — LEAVE ALL OF THIS EMPTY (ADR 0004)
# ---------------------------------------------------------------------------
# This app does not send email. There is no mail code in it, nothing reads
# these variables, and nothing breaks with them blank — the compose stack does
# not even pass them to the containers. You do not need an email provider, an
# AWS account, or a domain to run this.
#
# Your account's "email" is only the name you sign in with. It is never sent
# anything, so `dad@home` works as well as a real address.
#
# The names are reserved here so that if optional email is ever added, it is
# opt-in and these are what it will look for.

AWS_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=

# ---------------------------------------------------------------------------
# Optional third-party keys (plan §6.3, §6.6)
# ---------------------------------------------------------------------------
# Both are instance-wide and never exposed to users. The app works without
# either one.

# Pexels stock photography. Openverse and Wikimedia cover the feature alone.
PEXELS_API_KEY=

# Google Drive API key — lists public folder links used as photo sources.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Exposure
# ---------------------------------------------------------------------------

# Cloudflare Tunnel token. Compose runs cloudflared only under the `tunnel`
# profile, so local and LAN testing works with this empty.
CLOUDFLARE_TUNNEL_TOKEN=
