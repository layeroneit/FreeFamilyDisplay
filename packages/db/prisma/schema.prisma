// FreeFamilyDisplay — schema
//
// Phase 0 scope: users, sessions, invites. Nothing else.
// Later phases add login_tokens + email_suppressions (Phase 1), connections +
// cached_payloads (Phase 2), boards + board_widgets (Phase 3), displays +
// pairing_codes (Phase 4), cached_images (Phase 5). See plan §5 and §10.
//
// Two invariants hold across every table added here:
//   1. Passwords exist for OPERATOR accounts only (ADR 0003). Members are
//      passwordless by design (plan §8.1) — passwordHash is null for every
//      MEMBER, enforced at the repository layer, and no member-facing flow
//      may reference a password.
//   2. A credential is stored as a hash, never as itself. Invite tokens and
//      session tokens are SHA-256 hex; the plaintext exists only in transit and
//      in the recipient's email or cookie.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  /// Ordinary account. Owns boards, connections, and displays. Sees only its own.
  MEMBER

  /// Manages accounts — invites, disables, deletes. Deliberately CANNOT read
  /// another user's data (plan §2, permanent non-goal). Requires TOTP (Phase 1),
  /// because email is the only factor for everyone else.
  OPERATOR
}

model User {
  id String @id @default(cuid())

  /// Normalized to lowercase before write. The only identifier a user types.
  email       String    @unique @db.VarChar(320)
  displayName String    @db.VarChar(80)
  role        UserRole  @default(MEMBER)

  /// ADR 0003: bcrypt hash, OPERATOR accounts only. Null for every MEMBER —
  /// enforced at the repository layer (members have no password path at all),
  /// and the login route treats a null hash identically to a wrong password.
  passwordHash String? @db.VarChar(100)

  /// Set instead of deleting. Disabled users cannot log in and their displays
  /// stop rendering, but their data survives for restoration.
  disabledAt DateTime?

  /// End-user agreement (use at own risk, no warranty) — required before any
  /// authenticated page renders. Version string records which text was accepted.
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?   @db.VarChar(16)

  /// Selected UI theme id (one of the 10 built-ins, e.g. "midnight").
  /// Null = default. Applied to authenticated pages; boards get their own
  /// theme fields in Phase 3 per plan §5.
  uiTheme String? @db.VarChar(32)

  /// Per-category opt-in for the digest alerts in plan §6.7. Absent means
  /// everything off — notifications are opt-in, never opt-out.
  notifyPrefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  boards        Board[]
  invitesSent   Invite[]  @relation("InviteCreatedBy")
  inviteUsed    Invite?   @relation("InviteConsumedBy")

  @@index([disabledAt])
}

/// Server-side session records backing the signed cookie. Stateless cookies
/// alone would be simpler, but a table is what makes "I lost my phone"
/// answerable — a session can be revoked without rotating everyone's secret.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the session token. The token itself lives only in the cookie.
  tokenHash String @unique @db.VarChar(64)

  /// 90-day rolling (plan §8.1). Slides forward on use.
  expiresAt DateTime

  /// Set when explicitly signed out or revoked. Kept rather than deleted so a
  /// revocation is visible in an audit trail.
  revokedAt DateTime?

  /// Coarse client hint for the "your sessions" list — helps a user recognize
  /// which entry is the kitchen tablet. Not used for any security decision.
  userAgent String? @db.VarChar(255)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use signup token. There is no public registration (plan §3), with
/// exactly one permanent exception: the first-run form at /welcome, reachable
/// only while this table's User sibling is empty (ADR 0004). Every account
/// after that first one comes from an invite.
///
/// NOT YET IMPLEMENTED — no route, no UI, and nothing in the codebase writes a
/// row here. Until that exists, the first account is the only account an
/// instance can create through the app.
model Invite {
  id String @id @default(cuid())

  /// SHA-256 of a 32-byte random token (plan §8.1). Never the token itself.
  tokenHash String @unique @db.VarChar(64)

  /// Who the invite was addressed to, normalized lowercase. Checked against
  /// email_suppressions before sending (Phase 1).
  email String @db.VarChar(320)

  createdById String
  createdBy   User   @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  /// 7-day expiry.
  expiresAt DateTime

  /// Set on redemption. A non-null value means this invite is spent — enforced
  /// in the same transaction that creates the account, so a concurrent double
  /// redemption cannot create two users.
  consumedAt   DateTime?
  consumedById String?   @unique
  consumedBy   User?     @relation("InviteConsumedBy", fields: [consumedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Append-only record of security-relevant actions (plan §5). Rows are never
/// updated or deleted by application code.
model AuditLog {
  id String @id @default(cuid())

  /// Null when the actor is unknown — e.g. a failed login against an address
  /// that matches no account. The attempted email is deliberately NOT stored
  /// in that case; unknown addresses are noise with privacy weight.
  actorId String?

  /// Dotted verb, e.g. "auth.login.password.ok", "auth.login.password.failed",
  /// "auth.logout", "session.revoked".
  action String @db.VarChar(80)

  targetType String? @db.VarChar(40)
  targetId   String?

  /// Coarse client address for correlation. Not trusted for authorization.
  ip String? @db.VarChar(45)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — boards and widgets (plan §5, §7)
// ---------------------------------------------------------------------------

/// A display layout. The canvas is fixed at 1920×1080 (plan §7.1); widgets
/// are absolutely positioned in canvas pixels and the kiosk scales the whole
/// thing with a CSS transform. Tenancy: every query is scoped by userId.
model Board {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String @db.VarChar(80)

  /// Theme id from the built-in set (lib/themes.ts). Boards own their theme;
  /// User.uiTheme is only the admin UI's palette.
  theme String @default("midnight") @db.VarChar(32)

  /// Which fixed canvas this board is laid out on (1920×1080, 1080×1920, 2560×1080).
  canvas CanvasPreset @default(LANDSCAPE)

  /// Optional per-board look overrides — Phase 3 format panel (§7.3).
  /// Shape validated by zod at the API boundary, never trusted from the row.
  style Json?

  // --- wallpaper (spec §8 "boards additions") ---
  wallpaperCollectionId String?
  wallpaperCollection   WallpaperCollection? @relation(fields: [wallpaperCollectionId], references: [id], onDelete: SetNull)
  wallpaperRotation     WallpaperRotation    @default(WEEKLY)
  wallpaperOrder        WallpaperOrder       @default(SEQUENTIAL)
  currentWallpaperId    String?
  currentWallpaper      Wallpaper?           @relation("BoardCurrentWallpaper", fields: [currentWallpaperId], references: [id], onDelete: SetNull)
  lastRotatedAt         DateTime?

  /// Weekly THEME rotation - the outer loop. When set, the board moves itself
  /// to a different built-in collection every Monday 04:00, while the images
  /// inside that collection keep rotating on wallpaperRotation (the inner
  /// loop). Spec §10 said not to auto-switch collections; the operator
  /// overrode that on 2026-08-30, see docs/specs/wallpaper-collections.md.
  cycleCollections        Boolean   @default(false)
  lastCollectionRotatedAt DateTime?
  /// 0–1; null = use the image's suggested value.
  scrimOpacityOverride  Float?
  matchPaletteToWallpaper Boolean @default(false)

  // --- weather-reactive ambiance (plan §7.7.5) ---
  weatherMood         Boolean @default(false)
  /// 0–100
  weatherMoodStrength Int     @default(60)

  // --- display link (plan §8.2) ---
  /// SHA-256 of the display token, never the token itself — same rule as
  /// Session. A wall screen opens /d/<token> and gets this board read-only,
  /// with no session and no way to reach the admin UI. Null until the owner
  /// creates a link; rotating it instantly orphans every screen using the old
  /// one, which is the revocation story.
  displayTokenHash String?   @unique @db.VarChar(64)
  displayTokenAt   DateTime?
  /// Touched by the display route so the owner can see whether a screen is
  /// still alive. Coarse (at most one write a minute) to keep it cheap.
  displaySeenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  widgets BoardWidget[]

  @@index([userId, updatedAt])
}

model BoardWidget {
  id String @id @default(cuid())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  /// Catalog key: clock | date | greeting | weather | calendar | photos |
  /// quote | notes. Unknown keys are rejected at the API boundary.
  type String @db.VarChar(32)

  /// Canvas pixels on the 1920×1080 plane.
  x Int
  y Int
  w Int
  h Int
  z Int @default(0)

  /// Per-widget settings (weather location, greeting name, note text …).
  /// Validated per type by zod on write.
  config Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

/// Normalized external data written by `worker` on a schedule and read by
/// the render path (plan §4.2 — web never fetches). `kind` + `key` identify
/// a source: ("weather", "40.71,-74.01"), later ("ics", connectionId).
model CachedPayload {
  id String @id @default(cuid())

  kind String @db.VarChar(32)
  key  String @db.VarChar(120)

  payload   Json
  fetchedAt DateTime

  /// Last failure, actionable and secret-free ("HTTP 503 from Open-Meteo").
  lastError   String?   @db.VarChar(255)
  lastErrorAt DateTime?

  @@unique([kind, key])
  @@index([kind, fetchedAt])
}

// ---------------------------------------------------------------------------
// Wallpaper collections (docs/specs/wallpaper-collections.md)
// ---------------------------------------------------------------------------

/// A curated set of full-bleed photographs. ownerId null = built-in (visible
/// to everyone); otherwise private to the owner. Tenancy: queries scope by
/// `ownerId = me OR isBuiltin = true`.
model WallpaperCollection {
  id String @id @default(cuid())

  /// Stable slug for built-ins ("deep-space"); cuid-like for custom sets.
  slug String @unique @db.VarChar(64)

  ownerId     String?
  name        String  @db.VarChar(80)
  description String? @db.VarChar(200)
  isBuiltin   Boolean @default(false)

  /// Custom collections synced from a pasted share link. The link is a
  /// credential: stored encrypted (@ffd/crypto envelope), shown only as
  /// sourceMask. Null for built-ins.
  sourceSecret String?   @db.VarChar(2048)
  sourceMask   String?   @db.VarChar(200)
  lastSyncedAt DateTime?
  /// Actionable, secret-free ("album returned 404"). Shown in the editor.
  lastError    String?   @db.VarChar(255)

  /// Alternative source: a sub-directory of the drop folder mounted at
  /// WALLPAPER_DROP_DIR. A bare directory NAME, never a path — the worker
  /// joins it under the drop root so it cannot escape. Not a credential, so
  /// unlike sourceSecret it is stored and displayed in the clear.
  sourceFolder String? @db.VarChar(64)

  /// Alternative source: search terms for a public anime image index. Not a
  /// credential and not a URL - a space-separated tag list the owner typed,
  /// e.g. "scenery kimetsu_no_yaiba". The worker appends the fixed rating and
  /// blocklist itself; see apps/worker/src/connectors/anime-booru.ts for why
  /// that is not the caller's decision to make.
  sourceTags String? @db.VarChar(200)

  /// Free text the owner attaches to a collection they assembled themselves,
  /// rendered with the image on the board. Exists so a set of art someone
  /// else holds the rights to can say so on screen. A note is not a licence
  /// and does not make redistribution lawful — this is for private displays.
  rightsNote String? @db.VarChar(300)

  createdAt DateTime @default(now())

  wallpapers Wallpaper[]
  boards     Board[]

  @@index([ownerId])
}

model Wallpaper {
  id String @id @default(cuid())

  collectionId String
  collection   WallpaperCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  /// Path under /wallpapers (served from the web image), without size suffix.
  /// Sizes available: <base>-1920.webp, <base>-2560.webp.
  basePath String @db.VarChar(255)
  width    Int
  height   Int

  /// Derived once at ingest (spec §2): drive scrim and text color per image.
  meanLuminance        Float
  luminanceVariance    Float
  dominantColors       Json
  suggestedScrimOpacity Float
  /// 24px base64 placeholder so a board is never blank while the full asset loads.
  lqip String @db.VarChar(2048)

  /// photographer, source, license, sourceUrl — rendered as the credit line.
  attribution Json

  sortOrder Int     @default(0)
  pinned    Boolean @default(false)
  skipped   Boolean @default(false)

  createdAt DateTime @default(now())

  currentOnBoards Board[] @relation("BoardCurrentWallpaper")

  @@index([collectionId, sortOrder])
}

/// Fixed canvases (plan §7.1 amended 2026-08-30): one of three, never reflowed.
enum CanvasPreset {
  LANDSCAPE
  PORTRAIT
  ULTRAWIDE
}

enum WallpaperRotation {
  /// Sub-daily intervals are derived from the wall clock at render time
  /// rather than advanced by the worker - see lib/board/wallpapers.ts. The
  /// board reloads every 5 minutes, so EVERY_5_MIN is the practical floor.
  EVERY_5_MIN
  EVERY_15_MIN
  EVERY_30_MIN
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

enum WallpaperOrder {
  SEQUENTIAL
  SHUFFLE
}
