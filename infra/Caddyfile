# FreeFamilyDisplay — internal proxy (plan §4.2, §8.4)
#
# HTTPS on 8443 via Caddy's internal CA (operator requirement, 2026-08-29:
# "ensure this is ran in https"). Self-signed for a LAN IP, so browsers warn
# once per device — accept it; the alternative is credentials crossing the LAN
# in cleartext. The CA lives on a persistent volume so the cert is stable
# across restarts. Cloudflare-terminated TLS still arrives in Phase 6 for the
# tunnel path, which keeps using the plain :8080 site below (internal only,
# never published on the host).

{
	admin off
	# NOT `auto_https off` — that disables certificate MANAGEMENT too, so
	# `tls internal` below never mints anything and every handshake fails with
	# "internal error / no peer certificate" (found on first HTTPS deploy).
	# disable_redirects keeps automation on and only drops the http→https
	# redirect, which is meaningless here (the :8080 site is internal-only).
	auto_https disable_redirects
	servers {
		# Trust forwarded headers only from proxies inside the compose network.
		trusted_proxies static private_ranges
	}
}

# SITE_HOST is the LAN address displays and phones use, e.g. 192.168.1.50.
{$SITE_HOST}:8443 {
	tls internal

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		# HSTS still waits for the stable public hostname (plan §8.4, Phase 6).
		-Server
	}

	@health path /healthz /readyz
	log_skip @health

	reverse_proxy web:3010 {
		# {client_ip} honors trusted_proxies above and resolves the ORIGIN
		# client. {remote_host} would be the immediate peer — behind the
		# tunnel that is cloudflared's container IP for every visitor, which
		# collapses all rate limiting onto one shared key and makes every
		# audit-log IP identical.
		header_up X-Real-IP {client_ip}
	}

	log {
		output stdout
		format json
	}
}

# Plain-HTTP site for the future cloudflared path (TLS terminates at
# Cloudflare). Reachable only inside the compose network — not published.
:8080 {
	encode zstd gzip

	@health path /healthz /readyz
	log_skip @health

	reverse_proxy web:3010 {
		header_up X-Real-IP {client_ip}
	}

	log {
		output stdout
		format json
	}
}
